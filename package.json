{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "postinstall": "pnpm run build",
    "setup": "pnpm install",
    "setup:clean": "pnpm run clean:all && pnpm run setup",
    "build": "pnpm -r run build",
    "build:changed": "pnpm --filter=\"...[HEAD^1]\" run build",
    "test": "pnpm -r run test",
    "test:changed": "pnpm --filter=\"...[HEAD^1]\" run test",
    "watch": "pnpm -r --parallel run watch",
    "clean": "pnpm -r --parallel run clean",
    "clean:all": "pnpm -r exec -- rm -rf node_modules dist && rm -rf node_modules",
    "audit:high": "pnpm audit --audit-level high",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@types/node": "^20.12.12",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrostDigital/fruster.git"
  }
}
